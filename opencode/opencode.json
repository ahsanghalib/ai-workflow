{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": true,
  "default_agent": "engineer",
  "subagent_depth": 1,
  "formatter": false,
  "lsp": false,
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "permission": {
    "*": "ask",
    "todowrite": "allow",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.kubeconfig": "deny",
      "*/.netrc": "deny",
      "*/.npmrc": "deny",
      "*/.pypirc": "deny",
      "*/.aws/*": "deny",
      "*/.kube/*": "deny",
      "*/.ssh/*": "deny",
      "*/.local/share/opencode/auth.json": "deny",
      "credentials.json": "deny",
      "credentials.yml": "deny",
      "service-account.json": "deny",
      "firebase-adminsdk-*.json": "deny",
      "token.json": "deny",
      "tokens.json": "deny",
      ".git-credentials": "deny",
      "appsettings.*.json": "deny",
      "secrets.json": "deny",
      "*.tfvars": "deny",
      "*.tfvars.json": "deny",
      "id_rsa": "deny",
      "id_ed25519": "deny",
      ".config/gh/hosts.yml": "deny",
      ".docker/config.json": "deny",
      "auth.json": "deny"
    },
    "edit": "ask",
    "external_directory": "deny",
    "websearch": "allow",
    "webfetch": "ask",
    "task": "deny",
    "doom_loop": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch --show-current*": "allow",
      "rg *": "ask",
      "fd *": "ask",
      "sudo": "deny",
      "sudo *": "deny",
      "doas": "deny",
      "doas *": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "rm --recursive *": "deny",
      "find * -delete*": "deny",
      "shred *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny",
      "git checkout .": "deny",
      "git restore *": "deny",
      "git branch -D *": "deny",
      "git push *": "deny",
      "git worktree remove --force*": "deny",
      "terraform apply*": "deny",
      "terraform destroy*": "deny",
      "aws *": "deny",
      "kubectl *": "deny",
      "docker *": "deny",
      "npm publish*": "deny",
      "pnpm publish*": "deny",
      "pacman *": "deny",
      "yay *": "deny",
      "systemctl *": "deny"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".next/**",
      ".venv/**",
      "build/**",
      "coverage/**",
      "dist/**",
      "node_modules/**",
      "vendor/**"
    ]
  },
  "mcp": {}
}
