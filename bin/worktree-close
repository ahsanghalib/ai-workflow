#!/usr/bin/env bash
set -euo pipefail

die() {
	printf 'worktree-close: %s\n' "$*" >&2
	exit 1
}

resolve_existing_directory() {
	local path=$1

	[[ -d "$path" ]] || return 1
	(cd -P -- "$path" && pwd -P)
}

repository_slug_from_remote_url() {
	local remote_url=$1
	local authority path owner repo extra
	local without_scheme

	case "$remote_url" in
	*://*)
		without_scheme=${remote_url#*://}
		authority=${without_scheme%%/*}
		path=${without_scheme#*/}
		;;
	*:* )
		authority=${remote_url%%:*}
		path=${remote_url#*:}
		;;
	*)
		return 1
		;;
	esac

	authority=${authority##*@}
	path=${path%%\?*}
	path=${path%%\#*}
	path=${path%/}
	path=${path%.git}
	IFS=/ read -r owner repo extra <<< "$path"
	[[ -n "$authority" && -n "$owner" && -n "$repo" && -z ${extra:-} ]] ||
		return 1

	printf '%s/%s/%s\n' "$authority" "$owner" "$repo"
}

target_arg="${1:-}"
merged_into="${2:-origin/main}"

if [[ -z "$target_arg" ]]; then
	printf 'Usage: %s WORKTREE_PATH [MERGED_INTO_REF]\n' "$0" >&2
	exit 2
fi

if ! input_path="$(resolve_existing_directory "$target_arg" 2>/dev/null)"; then
	die "path does not exist: $target_arg"
fi

if ! target="$(git -C "$input_path" rev-parse --show-toplevel 2>/dev/null)"; then
	die "not inside a Git worktree: $input_path"
fi
if ! target="$(resolve_existing_directory "$target")"; then
	die "worktree root does not exist: $target"
fi

main_checkout="$({
	git -C "$target" worktree list --porcelain |
		awk '/^worktree / { print substr($0, 10); exit }'
} || true)"
[[ -n "$main_checkout" ]] || die 'could not determine the main Git checkout'
if ! main_checkout="$(resolve_existing_directory "$main_checkout")"; then
	die "main Git checkout does not exist: $main_checkout"
fi

if [[ "$target" == "$main_checkout" ]]; then
	die "refusing to remove the main checkout: $target"
fi

cwd="$(pwd -P)"
if [[ "$cwd" == "$target" || "$cwd" == "$target/"* ]]; then
	die "refusing to remove the current working tree; run this command from outside $target"
fi

branch="$(git -C "$target" branch --show-current)"
[[ -n "$branch" ]] || die "refusing to close a detached worktree: $target"

if [[ -n "$(git -C "$target" status --porcelain)" ]]; then
	printf 'Worktree is not clean: %s\n' "$target" >&2
	git -C "$target" status --short >&2
	exit 1
fi

ignored_status="$(git -C "$target" status --porcelain=v1 --ignored --untracked-files=normal |
		awk '$1 == "!!"')"
if [[ -n "$ignored_status" ]]; then
	printf 'Worktree contains ignored files that would be removed: %s\n' "$target" >&2
	printf '%s\n' "$ignored_status" >&2
	exit 1
fi

if ! branch_tip="$(git -C "$target" rev-parse --verify HEAD 2>/dev/null)"; then
	die "could not determine the current branch tip: $target"
fi

remote=""
base_branch="$merged_into"
if [[ "$merged_into" == */* ]]; then
	candidate_remote="${merged_into%%/*}"
	if git -C "$main_checkout" remote get-url "$candidate_remote" >/dev/null 2>&1; then
		remote="$candidate_remote"
		base_branch="${merged_into#*/}"
	fi
fi

if [[ -n "$remote" ]]; then
	printf 'Refreshing %s before merge verification...\n' "$remote"
	git -C "$main_checkout" fetch --prune "$remote"
fi

if ! git -C "$main_checkout" rev-parse --verify "${merged_into}^{commit}" >/dev/null 2>&1; then
	die "merge target does not exist: $merged_into"
fi

merge_proof='git ancestry'
pr_repo=''
pr_remote="$remote"

if [[ -z "$pr_remote" ]] &&
	git -C "$main_checkout" remote get-url origin >/dev/null 2>&1; then
	pr_remote=origin
fi
if [[ -n "$pr_remote" ]]; then
	remote_url="$(git -C "$main_checkout" remote get-url "$pr_remote" 2>/dev/null || true)"
	if [[ -n "$remote_url" ]]; then
		pr_repo="$(repository_slug_from_remote_url "$remote_url" || true)"
	fi
fi

if ! git -C "$main_checkout" merge-base --is-ancestor "$branch" "$merged_into"; then
	pr_number=""
	multiple_pr_matches=0
	if command -v gh >/dev/null 2>&1 && [[ -n "$pr_repo" ]]; then
		pr_candidates="$({
			cd "$main_checkout"
			gh pr list \
				--repo "$pr_repo" \
				--head "$branch" \
				--base "$base_branch" \
				--state merged \
				--limit 100 \
				--json number,headRefOid \
				--jq '.[] | [.number, .headRefOid] | @tsv' 2>/dev/null
		} || true)"

		while IFS=$'\t' read -r candidate_number candidate_head; do
			[[ -n "$candidate_number" && "$candidate_head" == "$branch_tip" ]] || continue
			if [[ -n "$pr_number" ]]; then
				multiple_pr_matches=1
				break
			fi
			pr_number="$candidate_number"
		done <<< "$pr_candidates"
	fi

	if (( multiple_pr_matches )); then
		printf 'Multiple merged GitHub PRs match branch %s at tip %s.\n' \
			"$branch" "$branch_tip" >&2
		exit 1
	elif [[ -n "$pr_number" ]]; then
		merge_proof="merged GitHub PR #${pr_number}"
	else
		printf 'Branch %s is not an ancestor of %s.\n' "$branch" "$merged_into" >&2
		printf 'A squash/rebase merge must match the current branch tip; authenticate GitHub CLI so it can be verified.\n' >&2
		exit 1
	fi
fi

git -C "$main_checkout" worktree remove "$target"

# Merge safety has already been verified above. Use -D deliberately so Git's
# upstream/deletion heuristics cannot override the explicit verification result.
git -C "$main_checkout" branch -D -- "$branch"

printf 'Removed worktree: %s\n' "$target"
printf 'Removed branch: %s\n' "$branch"
printf 'Merge verified by: %s\n' "$merge_proof"
