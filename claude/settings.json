{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "agent": "engineer",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(aws *)",
      "Bash(kubectl *)",
      "Bash(docker *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(systemctl *)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/.ssh/**)",
      "Read(//**/.aws/**)",
      "Read(//**/.kube/**)",
      "Read(//**/credentials.json)",
      "Read(//**/credentials.yml)",
      "Read(//**/credentials.yaml)",
      "Read(//**/service-account*.json)",
      "Read(//**/auth.json)",
      "Read(//**/token.json)",
      "Read(//**/tokens.json)"
    ]
  }
}
